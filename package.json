{
  "name": "trustchain-compliance",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "backup:export": "node --env-file-if-exists=.env scripts/backup.mjs export",
    "backup:restore": "node --env-file-if-exists=.env scripts/backup.mjs restore"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "express": "^5.1.0",
    "jsqr": "^1.4.0",
    "mongodb": "^6.20.0",
    "nodemailer": "^10.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

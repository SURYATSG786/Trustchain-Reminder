PORT=4317
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=trustchain
# First-run account setup is available only until an administrator is created.
ALLOW_SETUP=true
# Optional unattended setup; leave blank to create your own account in the browser.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Configure SMTP in the application's Email settings screen, or use these variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional 32-byte encryption key (64 hex characters). Otherwise .runtime-key is created locally.
APP_ENCRYPTION_KEY=
# Optional explicitly approved issuer names, separated by |. This is not an external issuer registry.
TRUSTED_ISSUERS=

# Required separate keys for encrypted production backups and Vercel scheduler
BACKUP_ENCRYPTION_KEY=
CRON_SECRET=
TRUST_PROXY=false

# Optional independent MongoDB backup destination (recommended for production)
BACKUP_MONGODB_URI=
BACKUP_MONGODB_DATABASE=trustchain_backups
